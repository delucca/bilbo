{
 "hooks": {
  "PreCompact": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "$PROBE/hook.sh CXPRECOMPACTPLAIN plain PreCompact"
     }
    ]
   },
   {
    "hooks": [
     {
      "type": "command",
      "command": "$PROBE/hook.sh CXPRECOMPACTJSON json PreCompact"
     }
    ]
   }
  ],
  "PostCompact": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "$PROBE/hook.sh CXPOSTCOMPACTPLAIN plain PostCompact"
     }
    ]
   },
   {
    "hooks": [
     {
      "type": "command",
      "command": "$PROBE/hook.sh CXPOSTCOMPACTJSON json PostCompact"
     }
    ]
   }
  ],
  "SessionStart": [
   {
    "matcher": "compact",
    "hooks": [
     {
      "type": "command",
      "command": "$PROBE/hook.sh CXSESSIONSTARTCOMPACT plain SessionStart"
     }
    ]
   },
   {
    "hooks": [
     {
      "type": "command",
      "command": "$PROBE/hook.sh CXSESSIONSTARTANY none SessionStart"
     }
    ]
   }
  ]
 }
}