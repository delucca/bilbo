build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml

# rules_rust passes no -Dwarnings to a crate with a lint_config, so --config=lint does.
build:lint --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect,@rules_rust//rust:defs.bzl%rustfmt_aspect
build:lint --output_groups=+clippy_checks,+rustfmt_checks
build:lint --@rules_rust//rust/settings:clippy_flags=-Dwarnings

test --build_tests_only
test --test_output=errors
test --test_tag_filters=-desktop,-release

test:unit --test_tag_filters=unit
test:contract --test_tag_filters=contract
test:acceptance --test_tag_filters=acceptance
test:integration --test_tag_filters=integration
test:snapshot --test_tag_filters=snapshot
test:e2e --test_tag_filters=e2e
test:release --test_tag_filters=release
test:desktop --test_tag_filters=desktop
test:all --test_tag_filters=
