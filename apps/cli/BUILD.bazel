load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")
load("//tools/bazel:version.bzl", "BILBO_VERSION")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    visibility = ["//tests:__subpackages__"],
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "bilbo_cli",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_root = "src/lib.rs",
    lint_config = ":lints",
    version = BILBO_VERSION,
    deps = [
        "//libs/rust/kinds",
        "//libs/rust/kinds/markdown",
        "//libs/rust/kinds/session",
        "//libs/rust/search",
        "//libs/rust/search/qwen",
        "//libs/rust/search/tantivy",
        "//libs/rust/search/whichlang",
        "//libs/rust/settings",
        "//libs/rust/store",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "bilbo",
    srcs = ["src/main.rs"],
    lint_config = ":lints",
    version = BILBO_VERSION,
    visibility = ["//tests:__subpackages__"],
    deps = [
        ":bilbo_cli",
        "//libs/rust/settings",
    ],
)

alias(
    name = "cli",
    actual = ":bilbo",
)

bilbo_rust_test(
    name = "unit",
    compile_data = ["//:docs/reference/configuration.md"],
    crate = ":bilbo_cli",
    layer = "unit",
    lint_config = ":lints",
    version = BILBO_VERSION,
)

bilbo_rust_test(
    name = "layout",
    srcs = ["tests/layout.rs"],
    data = glob(["src/**/*.rs"]),
    env = {"LAYOUT_ROOT": "$(rlocationpath src/lib.rs)"},
    layer = "integration",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "snapshot",
    srcs = ["tests/snapshot.rs"],
    compile_data = glob(["tests/snapshots/*"]) + [
        "//libs/rust/kinds/markdown:fixtures",
        "//libs/rust/kinds/session:fixtures",
    ],
    layer = "snapshot",
    lint_config = ":lints",
    version = BILBO_VERSION,
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/search",
        "//libs/rust/store",
    ],
)

bilbo_rust_test(
    name = "remember",
    srcs = [
        "tests/remember.rs",
        "tests/sandbox/mod.rs",
    ],
    crate_root = "tests/remember.rs",
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/store",
    ],
)

bilbo_rust_test(
    name = "sessions",
    srcs = [
        "tests/sandbox/mod.rs",
        "tests/sessions.rs",
    ],
    crate_root = "tests/sessions.rs",
    compile_data = ["//libs/rust/kinds/session:fixtures"],
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/store",
    ] + all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "read",
    srcs = ["tests/read.rs"],
    compile_data = [
        "//libs/rust/kinds/markdown:fixtures",
        "//libs/rust/kinds/session:fixtures",
    ],
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/store",
    ],
)

bilbo_rust_test(
    name = "recall",
    srcs = [
        "tests/recall.rs",
        "tests/sandbox/mod.rs",
    ],
    crate_root = "tests/recall.rs",
    compile_data = [
        "//libs/rust/kinds/markdown:fixtures",
        "//libs/rust/kinds/session:fixtures",
    ],
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/search",
        "//libs/rust/store",
        "@crates//:rustix",
    ] + all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "reindex",
    srcs = ["tests/reindex.rs"],
    compile_data = [
        "//libs/rust/kinds/markdown:fixtures",
        "//libs/rust/kinds/session:fixtures",
    ],
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/search",
        "//libs/rust/search/qwen",
        "//libs/rust/search/tantivy",
        "//libs/rust/store",
    ] + all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "timer",
    srcs = ["tests/timer.rs"],
    compile_data = [
        "//:docs/reference/commands.md",
        "//:docs/reference/timer/bilbo-remember.service",
        "//:docs/reference/timer/bilbo-remember.timer",
        "//:docs/reference/timer/io.github.delucca.bilbo.remember.plist",
    ],
    layer = "integration",
    lint_config = ":lints",
)

bilbo_rust_test(
    name = "readback",
    srcs = ["tests/readback.rs"],
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":bilbo_cli",
        "//libs/rust/kinds",
        "//libs/rust/store",
    ],
)
