load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")
load("//tools/bazel:version.bzl", "BILBO_VERSION")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    visibility = ["//tests:__subpackages__"],
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "bilbo_cli",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_root = "src/lib.rs",
    lint_config = ":lints",
    version = BILBO_VERSION,
    deps = [
        "//libs/derive:rust",
        "//libs/entries:rust",
        "//libs/llm:rust",
        "//libs/search:rust",
        "//libs/settings:rust",
        "//libs/store:rust",
    ] + all_crate_deps(normal = True),
)

rust_binary(
    name = "bilbo",
    srcs = ["src/main.rs"],
    lint_config = ":lints",
    version = BILBO_VERSION,
    visibility = ["//tests:__subpackages__"],
    deps = [
        ":bilbo_cli",
        "//libs/settings:rust",
    ],
)

alias(
    name = "cli",
    actual = ":bilbo",
)

bilbo_rust_test(
    name = "unit",
    compile_data = ["//:docs/reference/configuration.md"],
    crate = ":bilbo_cli",
    layer = "unit",
    lint_config = ":lints",
    version = BILBO_VERSION,
)

bilbo_rust_test(
    name = "layout",
    srcs = ["tests/layout.rs"],
    data = glob([
        "src/**/*.rs",
        "tests/**/*.rs",
    ]),
    env = {"LAYOUT_ROOT": "$(rlocationpath src/lib.rs)"},
    layer = "integration",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "snapshot",
    srcs = ["tests/snapshot.rs"],
    compile_data = glob(["tests/snapshots/*"]) + [
        "//libs/entries/rust:markdown_fixtures",
        "//libs/entries/rust:note_fixtures",
        "//libs/entries/rust:session_fixtures",
    ],
    layer = "snapshot",
    lint_config = ":lints",
    version = BILBO_VERSION,
    deps = [
        ":bilbo_cli",
        "//libs/derive:rust",
        "//libs/entries:rust",
        "//libs/llm:rust",
        "//libs/search:rust",
        "//libs/store:rust",
    ],
)

