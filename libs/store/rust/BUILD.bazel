load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "rust",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_store",
    lint_config = ":lints",
    visibility = ["//libs/store:__pkg__"],
    deps = ["//libs/settings:rust"] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    crate = ":rust",
    layer = "unit",
    lint_config = ":lints",
    size = "medium",
)

bilbo_rust_test(
    name = "integration",
    srcs = glob(["tests/integration/*.rs"]),
    crate_root = "tests/integration/main.rs",
    layer = "integration",
    lint_config = ":lints",
    deps = [":rust"] + all_crate_deps(normal = True),
)
