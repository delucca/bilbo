load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

cargo_build_script(
    name = "build",
    srcs = ["build.rs"],
    data = [
        "//libs/derive:instructions",
        "//libs/derive:tags_instruction",
    ],
    lint_config = ":lints",
    deps = all_crate_deps(build = True),
)

alias(
    name = "script",
    actual = ":build_",
)

rust_library(
    name = "rust",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_derive",
    lint_config = ":lints",
    visibility = ["//libs/derive:__pkg__"],
    deps = [
        ":build",
        "//libs/entries:rust",
        "//libs/llm:rust",
        "//libs/settings:rust",
        "//libs/store:rust",
    ] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    crate = ":rust",
    layer = "unit",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "acceptance",
    srcs = glob(["tests/acceptance/*.rs"]),
    crate_root = "tests/acceptance/main.rs",
    layer = "acceptance",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//libs/entries:rust",
        "//libs/llm:rust",
        "//libs/store:rust",
    ] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "contract",
    srcs = glob(["tests/contract/*.rs"]),
    crate_root = "tests/contract/main.rs",
    layer = "contract",
    lint_config = ":lints",
    deps = [":rust"],
)

bilbo_rust_test(
    name = "layout",
    srcs = ["tests/layout.rs"],
    data = glob([
        "src/**/*.rs",
        "tests/**/*.rs",
    ]) + ["Cargo.toml"],
    env = {"LAYOUT_ROOT": "$(rlocationpath Cargo.toml)"},
    layer = "integration",
    lint_config = ":lints",
    deps = ["//tools/rust/layout"] + all_crate_deps(normal_dev = True),
)
