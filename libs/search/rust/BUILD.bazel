load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "rust",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/qwen/tokenizer.json.zst"],
    crate_name = "bilbo_search",
    lint_config = ":lints",
    visibility = ["//libs/search:__pkg__"],
    deps = [
        "//libs/entries:rust",
        "//libs/language:rust",
        "//libs/settings:rust",
        "//libs/store:rust",
    ] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    compile_data = ["src/qwen/tokenizer.json.zst"],
    crate = ":rust",
    layer = "unit",
    lint_config = ":lints",
    size = "medium",
)

bilbo_rust_test(
    name = "acceptance",
    srcs = glob(["tests/acceptance/*.rs"]),
    crate_root = "tests/acceptance/main.rs",
    layer = "acceptance",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//libs/entries:rust",
        "//libs/store:rust",
    ],
)

bilbo_rust_test(
    name = "contract",
    srcs = glob(["tests/contract/*.rs"]),
    compile_data = glob([
        "tests/contract/*.jsonl",
        "tests/contract/*.zst",
    ]),
    crate_root = "tests/contract/main.rs",
    layer = "contract",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//libs/entries:rust",
        "//libs/store:rust",
        "@crates//:zstd",
    ] + all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "integration",
    srcs = glob(["tests/integration/*.rs"]),
    crate_root = "tests/integration/main.rs",
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//libs/store:rust",
    ] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "layout",
    srcs = ["tests/layout.rs"],
    data = glob([
        "src/**/*.rs",
        "tests/**/*.rs",
    ]) + ["Cargo.toml"],
    env = {"LAYOUT_ROOT": "$(rlocationpath Cargo.toml)"},
    layer = "integration",
    lint_config = ":lints",
    deps = ["//tools/rust/layout"] + all_crate_deps(normal_dev = True),
)
