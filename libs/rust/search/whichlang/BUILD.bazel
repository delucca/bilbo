load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "whichlang",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_whichlang",
    lint_config = ":lints",
    visibility = [
        "//apps/cli:__pkg__",
    ],
    deps = ["//libs/rust/search"] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    crate = ":whichlang",
    layer = "unit",
    lint_config = ":lints",
)
