load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "tantivy",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_tantivy",
    lint_config = ":lints",
    visibility = ["//apps/cli:__pkg__"],
    deps = [
        "//libs/rust/search",
        "//libs/rust/store",
    ] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    crate = ":tantivy",
    layer = "unit",
    lint_config = ":lints",
)

bilbo_rust_test(
    name = "integration",
    srcs = glob(["tests/integration/*.rs"]),
    crate_root = "tests/integration/main.rs",
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":tantivy",
        "//libs/rust/search",
        "//libs/rust/store",
    ] + all_crate_deps(normal = True),
)
