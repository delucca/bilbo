load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "settings",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_settings",
    lint_config = ":lints",
    visibility = [
        "//apps/cli:__pkg__",
        "//libs/rust/store:__pkg__",
    ],
    deps = all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    crate = ":settings",
    layer = "unit",
    lint_config = ":lints",
)

bilbo_rust_test(
    name = "integration",
    srcs = glob(["tests/integration/*.rs"]),
    crate_root = "tests/integration/main.rs",
    layer = "integration",
    lint_config = ":lints",
    deps = [":settings"],
)
