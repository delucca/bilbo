load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "session",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_session",
    lint_config = ":lints",
    visibility = ["//apps/cli:__pkg__"],
    deps = [
        "//libs/rust/kinds",
        "//libs/rust/store",
    ] + all_crate_deps(normal = True),
)

filegroup(
    name = "fixtures",
    srcs = glob(["fixtures/*"]),
    visibility = [
        "//apps/cli:__pkg__",
        "//tests/e2e/cli:__pkg__",
    ],
)

bilbo_rust_test(
    name = "unit",
    compile_data = [":fixtures"],
    crate = ":session",
    layer = "unit",
    lint_config = ":lints",
)

bilbo_rust_test(
    name = "contract",
    srcs = glob(["tests/contract/*.rs"]),
    compile_data = glob(["tests/contract/*.jsonl"]),
    crate_root = "tests/contract/main.rs",
    layer = "contract",
    lint_config = ":lints",
    deps = [
        ":session",
        "//libs/rust/kinds",
    ] + all_crate_deps(normal_dev = True),
)
