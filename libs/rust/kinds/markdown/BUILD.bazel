load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "markdown",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_markdown",
    lint_config = ":lints",
    visibility = ["//apps/cli:__pkg__"],
    deps = [
        "//libs/rust/kinds",
        "//libs/rust/settings",
        "//libs/rust/store",
    ],
)

filegroup(
    name = "fixtures",
    srcs = glob(["fixtures/*"]),
    visibility = [
        "//apps/cli:__pkg__",
        "//tests/e2e/cli:__pkg__",
    ],
)

bilbo_rust_test(
    name = "unit",
    compile_data = [":fixtures"],
    crate = ":markdown",
    layer = "unit",
    lint_config = ":lints",
)
