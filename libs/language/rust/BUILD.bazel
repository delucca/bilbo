load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

cargo_build_script(
    name = "build",
    srcs = ["build.rs"],
    data = ["//libs/language:locales"],
    lint_config = ":lints",
    deps = all_crate_deps(build = True),
)

# cargo_build_script tags its binary manual, so //... skips it; this puts it in the lint build.
alias(
    name = "script",
    actual = ":build_",
)

rust_library(
    name = "rust",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_language",
    lint_config = ":lints",
    visibility = ["//libs/language:__pkg__"],
    deps = [":build"],
)

bilbo_rust_test(
    name = "unit",
    crate = ":rust",
    layer = "unit",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)
