load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "rust",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_entries",
    lint_config = ":lints",
    visibility = ["//libs/entries:__pkg__"],
    deps = [
        "//libs/settings:rust",
        "//libs/store:rust",
    ] + all_crate_deps(normal = True),
)

filegroup(
    name = "markdown_fixtures",
    srcs = glob(["fixtures/markdown/*"]),
    visibility = [
        "//apps/cli:__pkg__",
        "//tests/e2e/cli:__pkg__",
    ],
)

filegroup(
    name = "session_fixtures",
    srcs = glob(["fixtures/session/*"]),
    visibility = [
        "//apps/cli:__pkg__",
        "//tests/e2e/cli:__pkg__",
    ],
)

filegroup(
    name = "note_fixtures",
    srcs = glob(["fixtures/note/*"]),
    visibility = [
        "//apps/cli:__pkg__",
        "//tests/e2e/cli:__pkg__",
    ],
)

bilbo_rust_test(
    name = "unit",
    compile_data = [
        ":markdown_fixtures",
        ":note_fixtures",
        ":session_fixtures",
    ],
    crate = ":rust",
    layer = "unit",
    lint_config = ":lints",
)

bilbo_rust_test(
    name = "acceptance",
    srcs = glob(["tests/acceptance/*.rs"]),
    crate_root = "tests/acceptance/main.rs",
    layer = "acceptance",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//libs/store:rust",
    ],
)

bilbo_rust_test(
    name = "contract",
    srcs = glob(["tests/contract/*.rs"]),
    compile_data = glob(["tests/contract/*.jsonl"]) + [":session_fixtures"],
    crate_root = "tests/contract/main.rs",
    layer = "contract",
    lint_config = ":lints",
    deps = [":rust"] + all_crate_deps(normal = True, normal_dev = True),
)

bilbo_rust_test(
    name = "layout",
    srcs = ["tests/layout.rs"],
    data = glob([
        "src/**/*.rs",
        "tests/**/*.rs",
    ]) + ["Cargo.toml"],
    env = {"LAYOUT_ROOT": "$(rlocationpath Cargo.toml)"},
    layer = "integration",
    lint_config = ":lints",
    deps = ["//tools/rust/layout"] + all_crate_deps(normal_dev = True),
)
