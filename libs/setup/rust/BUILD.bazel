load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools/bazel:rust.bzl", "bilbo_rust_test")

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "rust",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bilbo_setup",
    lint_config = ":lints",
    visibility = ["//libs/setup:__pkg__"],
    deps = [
        "//libs/settings:rust",
    ] + all_crate_deps(normal = True),
)

bilbo_rust_test(
    name = "unit",
    compile_data = glob(["fixtures/**"]) + [
        "//:docs/reference/timer/bilbo-derive.service",
        "//:docs/reference/timer/bilbo-derive.timer",
        "//:docs/reference/timer/bilbo-refresh.service",
        "//:docs/reference/timer/bilbo-refresh.timer",
        "//:docs/reference/timer/io.github.delucca.bilbo.derive.plist",
        "//:docs/reference/timer/io.github.delucca.bilbo.refresh.plist",
    ],
    crate = ":rust",
    layer = "unit",
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)

bilbo_rust_test(
    name = "acceptance",
    srcs = glob(["tests/acceptance/*.rs"]),
    crate_root = "tests/acceptance/main.rs",
    layer = "acceptance",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//libs/settings:rust",
    ],
)

bilbo_rust_test(
    name = "integration",
    srcs = glob(["tests/integration/*.rs"]),
    crate_root = "tests/integration/main.rs",
    layer = "integration",
    lint_config = ":lints",
    deps = [
        ":rust",
        "//tools/rust/programs",
        "@crates//:rustix",
        "@crates//:serde_json",
    ],
)

bilbo_rust_test(
    name = "layout",
    srcs = ["tests/layout.rs"],
    data = glob([
        "src/**/*.rs",
        "tests/**/*.rs",
    ]) + ["Cargo.toml"],
    env = {"LAYOUT_ROOT": "$(rlocationpath Cargo.toml)"},
    layer = "integration",
    lint_config = ":lints",
    deps = ["//tools/rust/layout"] + all_crate_deps(normal_dev = True),
)
